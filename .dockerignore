node_modules
**/node_modules
**/dist
**/*.tsbuildinfo
.git
.vscode
test
*.log

# Runtime data files (see .gitignore) - these belong in the mounted /data
# volume, never baked into the image from whatever happens to be on the
# machine doing the build.
table-style-presets.json
pack-selection-presets.json
game-setup-presets.json
custom-cards.json
custom-sets.json

# docs/mockups is served at runtime (server/src/index.ts) and must NOT be
# excluded - only the design-doc source assets outside that folder, if any
# get added later, would go here.

# Every other runtime/private file that can exist in a working copy (see
# .gitignore). A local `docker build` must match a clean-checkout CI build:
# none of these may reach the image.
admin-password.json
core-set.json
default-theme.json
game-name.json
role-names.json
cards-full.json
*.tmp
.env
CLAUDE.local.md
scripts/deploy.ps1
.claude
