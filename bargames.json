{
  "id": "nofilter",
  "name": "No Filter",
  "version": "1.3.2",
  "image": "ghcr.io/thezigpc/nofilter:1.3.2",
  "port": 3001,
  "sdk": { "version": "0.13.0", "level": 3 },
  "routes": {
    "player": "/",
    "table": "/room/{code}?role=table&display=1",
    "host": "/room/new",
    "admin": "/admin"
  },
  "routing": { "basePath": true },
  "health": "/health",
  "events": ["room_created", "room_closed", "players_changed", "round_started", "round_ended", "winner", "game_over"],
  "commands": ["create_room", "start", "next_round", "end"],
  "brandable": ["displayName", "tagline", "accent"],
  "sessionKinds": ["venue", "patron"],
  "resources": { "memory": "256m", "cpus": 1 },
  "network": { "internet": false },
  "env": { "DATA_DIR": "/data" }
}
