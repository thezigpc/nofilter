# Copy to .env (gitignored) and fill in real values. docker-compose.yml
# reads this automatically - never commit the filled-in version.

# Optional. Gates writes to the shared card library (custom cards, sets,
# Core Set, game name, backup restore) - see server/src/admin/auth.ts.
# Leave this unset for a fresh deploy: the app serves a one-time setup
# wizard on the room-admin panel instead, and whoever completes it becomes
# admin. Set this only if you'd rather manage the password via env/.env
# the old way - doing so disables the wizard entirely.
ADMIN_PASSWORD=

# Optional. debug | info | warn | error (default: info)
LOG_LEVEL=
